en(movers)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-31T16:10:07.853102Z","iopub.execute_input":"2026-10-31T16:10:07.853517Z","iopub.status.idle":"2026-10-31T16:10:07.870462Z","shell.execute_reply.started":"2026-10-31T16:10:07.853487Z","shell.execute_reply":"2026-10-31T16:10:07.869509Z"}},"outputs":[],"execution_count":21},{"cell_type":"code","source":"town = Town(threshold=0.4, seed=3)\n\nprint(\n    \"Start: like share\",\n    round(town.average_like_share(), 2),\n    \", discontent:\",\n    len(town.discontent())\n)\n\nrounds = 0\n\nwhile True:\n    moved = town.play_round()\n    rounds += 1\n\n    if rounds in (1, 2, 5, 10, 15) or moved == 0:\n        print(\n            f\"Round {rounds}: moved {moved}, \"\n            f\"like share {town.average_like_share():.2f}\"\n        )\n\n    if moved == 0:\n        break","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-31T16:10:25.468165Z","iopub.execute_input":"2026-10-31T16:10:25.468518Z","iopub.status.idle":"2026-10-31T16:10:25.660536Z","shell.execute_reply.started":"2026-10-31T16:10:25.468487Z","shell.execute_reply":"2026-10-31T16:10:25.659566Z"}},"outputs":[{"name":"stdout","text":"Start: like share 0.49 , discontent: 459\nRound 1: moved 459, like share 0.62\nRound 2: moved 245, like share 0.70\nRound 5: moved 60, like share 0.81\nRound 10: moved 13, like share 0.84\nRound 15: moved 3, like share 0.85\nRound 22: moved 0, like share 0.85\n","output_type":"stream"}],"execution_count":22},{"cell_type":"code","source":"for threshold in [0.2, 0.4, 0.6]:\n\n    rounds_used, shares = [], []\n\n    for s in range(10):\n        town = Town(threshold=threshold, seed=s)\n\n        r = 0\n\n        while r < 100 and town.play_round() > 0:\n            r += 1\n\n        rounds_used.append(r)\n        shares.append(town.average_like_share())\n\n    print(\n        f\"threshold {threshold}: \"\n        f\"rounds {statistics.mean(rounds_used):.1f}, \"\n        f\"like share {statistics.mean(shares):.2f}\"\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-31T16:10:40.225059Z","iopub.execute_input":"2026-10-31T16:10:40.225446Z","iopub.status.idle":"2026-10-31T16:10:47.645446Z","shell.execute_reply.started":"2026-10-31T16:10:40.225417Z","shell.execute_reply":"2026-10-31T16:10:47.644422Z"}},"outputs":[{"name":"stdout","text":"threshold 0.2: rounds 6.2, like share 0.58\nthreshold 0.4: rounds 16.6, like share 0.82\nthreshold 0.6: rounds 91.7, like share 0.97\n","output_type":"stream"}],"execution_count":23},{"cell_type":"code","source":"#Task 5\nSPOTS = [\"crate\", \"door\", \"shelf\", \"barrel\", \"curtain\"]\n\nHIDE_PROB = [0.10, 0.45, 0.05, 0.30, 0.10]\n\n\nclass HidingPlayer:\n\n    def __init__(self, seed):\n        self.rng = random.Random(seed)\n\n    def hide(self):\n        return self.rng.choices(\n            range(len(SPOTS)),\n            weights=HIDE_PROB\n        )[0]\n\n\ndef critic(spot, hidden):\n    return 1 if spot == hidden else 0\n\n\ndef play(epsilon, rounds=500, seed=0):\n    guard, player = LearningGuard(epsilon, seed), HidingPlayer(1000 + seed)\n\n    wins = 0\n\n    for _ in range(rounds):\n        spot = guard.choose()\n        reward = critic(spot, player.hide())\n\n        guard.learn(spot, reward)\n        wins += reward\n\n    return wins / rounds, guard","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-31T16:29:48.616495Z","iopub.execute_input":"2026-10-31T16:29:48.616879Z","iopub.status.idle":"2026-10-31T16:29:48.625777Z","shell.execute_reply.started":"2026-10-31T16:29:48.616839Z","shell.execute_reply":"2026-10-31T16:29:48.624927Z"}},"outputs":[],"execution_count":24},{"cell_type":"code","source":"class LearningGuard:\n\n    def __init__(self, epsilon, seed):\n        self.epsilon = epsilon\n        self.rng = random.Random(seed)\n\n        self.checked = [0] * len(SPOTS)\n        self.found = [0] * len(SPOTS)\n\n    def estimate(self, i):\n        if self.checked[i] == 0:\n            return 0.0\n\n        return self.found[i] / self.checked[i]\n\n    def choose(self):\n\n        if self.rng.random() < self.epsilon:\n            return self.rng.randrange(len(SPOTS))\n\n        estimates = [\n            self.estimate(i)\n            for i in range(len(SPOTS))\n        ]\n\n        best = max(estimates)\n\n        choices = [\n            i for i in range(len(SPOTS))\n            if self.estimate(i) == best\n        ]\n\n        return self.rng.choice(choices)\n\n    def learn(self, spot, reward):\n        self.checked[spot] += 1\n        self.found[spot] += reward","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-31T16:30:04.716865Z","iopub.execute_input":"2026-10-31T16:30:04.71725Z","iopub.status.idle":"2026-10-31T16:30:04.726245Z","shell.execute_reply.started":"2026-10-31T16:30:04.717221Z","shell.execute_reply":"2026-10-31T16:30:04.725224Z"}},"outputs":[],"execution_count":25},{"cell_type":"code","source":"for epsilon in [1.0, 0.0, 0.05, 0.1, 0.3]:\n\n    rates = [\n        play(epsilon, 500, seed)[0]\n        for seed in range(100)\n    ]\n\n    print(\n        f\"epsilon {epsilon}: \"\n        f\"success rate {statistics.mean(rates):.3f}\"\n    )\n\n\nfor epsilon in [0.1, 0.0]:\n\n    rate, guard = play(epsilon, 500, 0)\n\n    print(\n        \"epsilon\", epsilon,\n        \"seed 0: success\", rate,\n        \"checks\", guard.checked\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-31T16:30:15.94871Z","iopub.execute_input":"2026-10-31T16:30:15.949063Z","iopub.status.idle":"2026-10-31T16:30:17.072645Z","shell.execute_reply.started":"2026-10-31T16:30:15.949035Z","shell.execute_reply":"2026-10-31T16:30:17.071588Z"}},"outputs":[{"name":"stdout","text":"epsilon 1.0: success rate 0.201\nepsilon 0.0: success rate 0.327\nepsilon 0.05: success rate 0.381\nepsilon 0.1: success rate 0.394\nepsilon 0.3: success rate 0.363\nepsilon 0.1 seed 0: success 0.39 checks [14, 410, 8, 56, 12]\nepsil